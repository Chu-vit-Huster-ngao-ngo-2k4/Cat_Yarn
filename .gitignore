android/app/src/main/assets/public/

# Ký ứng dụng release — TUYỆT ĐỐI không commit file keystore thật
*.keystore
*.jks

# OS / editor junk
.DS_Store
Thumbs.db
*.iml
.idea/

# Python (chạy tools/*.py tạo ra, không cần track)
__pycache__/
*.pyc
